# Variáveis de ambiente do site (Netlify → Project configuration → Environment variables)
#
# SITE_PASSWORD   senha única do grupo; protege o site inteiro (inclusive /api/state)
# SESSION_SECRET  string aleatória longa para assinar o cookie de sessão
#
# Gere o segredo com:  openssl rand -base64 32
#
# Copie este arquivo para `.env` para rodar `netlify dev` localmente.
# O `.env` NUNCA vai para o repositório (está no .gitignore).

SITE_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-aleatoria-bem-longa
